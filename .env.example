# =============================================================================
# Shopfloor Monitor — пример окружения (скопируйте в .env и заполните)
# НИКОГДА не коммитьте реальный .env
# =============================================================================

# --- Flask ---
SECRET_KEY=change-me
LOG_LEVEL=INFO

# --- PostgreSQL (TotalCore / conveyor), опционально ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- RabbitMQ (агрегация TotalMark), по умолчанию выкл ---
RABBIT_ENABLED=0
RABBIT_HOST=
RABBIT_PORT=5672
RABBIT_USER=
RABBIT_PASSWORD=
RABBIT_VHOST=/
RABBIT_QUEUES=aggregation

# --- Honest API / ТСД (факт крупной тары) ---
# Base URL вида: https://tm.totalmark.pro/<YOUR_TENANT_ID>
# Путь методов: /hs/Honest/jobs/shipment и /hs/Honest/job/shipment/info
TSD_POLL_ENABLED=0
TSD_BASE_URL=
TSD_USER=
TSD_PASSWORD=
# Альтернатива логину/паролю — готовый заголовок:
# TSD_AUTH_BASIC=Basic base64(user:password)
TSD_ORG=
TSD_WAREHOUSE=
TSD_STRICT_PLAN_DATE=1
TSD_MIN_PACK_KG=45
# TSD_STATE_FILE=tsd_state.json
# TSD_POLL_SEC=60

# --- Excel план производства ---
# PRODUCTION_PLAN_FILE=data/plan.xlsx

# --- Справочник GTIN→имя (лист «Краткий отчет») ---
# файл: data/Краткий отчет.xlsx

# --- Алерты MAX (опционально) ---
MAX_ENABLED=0
# секреты лучше в max_bot.local.env (см. README_MAX_BOT.md)

# --- Прочее ---
VPS_PUSH_ENABLED=0
ALLOW_MULTI_INSTANCE=0
